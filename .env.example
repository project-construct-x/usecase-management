# ============================================
# DOCKER & ENTWICKLER
# ============================================
DEV_USER=user1
DB_PORT=5433
BACKEND_PORT=8001
FRONTEND_PORT=5174

# ============================================
# DATENBANK
# ============================================
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=appdb

# ============================================
# AUTHENTICATION (nur Production)
# ============================================
# Nginx Basic Auth Credentials
NGINX_READER_USER=reader
NGINX_READER_PASS=SICHERES_READER_PASSWORT
NGINX_ADMIN_USER=admin
NGINX_ADMIN_PASS=SICHERES_ADMIN_PASSWORT

# Initiale Datenbank-User (für init_db.py)
DB_READER_USER=reader
DB_READER_PASS=SICHERES_READER_PASSWORT
DB_ADMIN_USER=admin
DB_ADMIN_PASS=SICHERES_ADMIN_PASSWORT

# ============================================
# BACKEND
# ============================================
DATABASE_URL=postgresql://dbuser:change_this_password@db:5432/appdb
IMAGE_DIR=/app/static/images
ENV=development

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:8001